---
import RecentPostList from "./RecentPostList.astro";
import { pathWithBase } from "../utils/base";
import { getRecentPosts, recentPageCount, INITIAL_COUNT, PAGE_SIZE } from "../utils/recent-posts";

const posts = await getRecentPosts();
const pages = recentPageCount(posts.length);
---

<div class="mt-[75px]">
  <span>최신글</span>
  <div class="line"></div>
  <div class="flex flex-col gap-3 recent-list">
    <RecentPostList posts={posts.slice(0, INITIAL_COUNT)} />
    <div class="recent-skeleton" style={`--skeleton-cards: ${PAGE_SIZE}`} hidden></div>
  </div>
  <div
    style="margin-top: 40px; display: flex; align-items: center; justify-content: center;"
  >
    <div class="more" data-recent-base={pathWithBase("recent/")} data-recent-pages={pages}>
      <div style="display: flex; align-items: center; justify-content: center;">
        + 더보기
      </div>
    </div>
  </div>
</div>

<script>
  const more = document.querySelector<HTMLElement>(".more");
  const skeleton = document.querySelector<HTMLElement>(".recent-skeleton");
  if (more && skeleton) {
    const total = Number(more.dataset.recentPages);
    let page = 1;
    let loading = false;
    more.addEventListener("click", async () => {
      if (page > total || loading) return;
      loading = true;
      const timer = setTimeout(() => (skeleton.hidden = false), 500);
      const res = await fetch(`${more.dataset.recentBase}${page}/`);
      clearTimeout(timer);
      skeleton.hidden = true;
      loading = false;
      if (!res.ok) return;
      const doc = new DOMParser().parseFromString(await res.text(), "text/html");
      skeleton.before(...doc.body.children);
      page++;
      if (page > total) more.style.display = "none";
    });
  }
</script>

<style>
  .line {
    margin-top: 0.5rem;
    height: 0.07rem;
    background: var(--sl-color-gray-3);
  }

  .more {
    width: 70px;
    border-radius: 20px;
    margin: auto 0;
    background: var(--sl-color-gray-6);
    cursor: pointer;
  }

  .recent-skeleton {
    height: calc(var(--skeleton-cards) * 4.9rem);
    background: repeating-linear-gradient(
      var(--sl-color-gray-6) 0 1.2rem,
      transparent 1.2rem 1.7rem,
      var(--sl-color-gray-6) 1.7rem 2.4rem,
      transparent 2.4rem 2.9rem,
      var(--sl-color-gray-6) 2.9rem 3.6rem,
      transparent 3.6rem 4.9rem
    );
    animation: skeleton-pulse 1.2s ease-in-out infinite;
  }

  @keyframes skeleton-pulse {
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-skeleton {
      animation: none;
    }
  }
</style>
